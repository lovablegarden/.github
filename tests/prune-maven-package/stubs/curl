#!/usr/bin/env bash
# Fake curl for run-tests.sh: serves BOM POMs from $FIX/poms and prints the HTTP code.
out='' url='' auth=''
while [ $# -gt 0 ]; do
  case $1 in
    -o) out=$2; shift 2 ;;
    -u) auth=$2; shift 2 ;;
    -w) shift 2 ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
echo "curl $url" >> "$FIX/calls.log"
v=$(basename "$(dirname "$url")")
# The Maven registry rejects the app token, as the real one does
[ "$auth" = "x-access-token:$FAKE_PACKAGES_TOKEN" ] || { : > "$out"; printf 401; exit 0; }
[ -f "$FIX/poms/$v.unreachable" ] && { echo "curl: (7) Failed to connect" >&2; exit 7; }
[ -f "$FIX/poms/$v.500" ] && { : > "$out"; printf 500; exit 0; }
if [ -f "$FIX/poms/$v.pom" ]; then cp "$FIX/poms/$v.pom" "$out"; printf 200; else printf 404; fi
